#
# Makefile.OSX
#
# Makefile for Mac OS X systems using clang.
#


###############################################################################
# Build Options
###############################################################################

DELETE = rm -d -r -f


###############################################################################
# Release Package Options
###############################################################################

PKG_TYPE = tgz
# The macOS package bundles MoltenVK so Vulkan works without Homebrew or the Vulkan SDK.
PKG_FILES = Frameworks/*.framework Frameworks/libMoltenVK.dylib Frameworks/MoltenVK_icd.json Frameworks/LICENSE-MoltenVK.txt


###############################################################################
# Platform Configuration
#
# Edit library and include paths as needed.
###############################################################################

#
# Must be included first
#
include Makefiles/Options.inc

#
# Toolchain
#
CC = clang
CXX = clang
LD = clang

#
# SDL
#

SDL_CFLAGS =
SDL_LIBS = -framework SDL2 -framework SDL2_net -framework OpenGL -framework GLUT -framework Cocoa

#
# macOS-specific
#

PLATFORM_CXXFLAGS = -F./Frameworks -IFrameworks/SDL2.framework/Headers $(SDL_CFLAGS) -DSUPERMODEL_OSX
PLATFORM_LDFLAGS = $(ARCH) -F./Frameworks $(SDL_LIBS) -lz -lm -lstdc++ -Wl,-rpath,@executable_path/../Frameworks -Wl,-rpath,@executable_path/Frameworks
PLATFORM_DIRS = Frameworks/SDL2_net.framework Frameworks/SDL2.framework Frameworks/libMoltenVK.dylib
PLATFORM_BINARY_EXTENSION =

#
# GitHub token
#
# In GitHub Actions, a token must be used to access the GitHub API (we use curl
# and the GitHub API to download SDL dependencies). If GITHUB_TOKEN is passed to
# the Makefile (which it will be in the GitHub Actions scripts), we pass the
# token as an authorization header with curl. Otherwise, nothing.
#
ifdef GITHUB_TOKEN
GITHUB_TOKEN_CURL_ARGUMENT = -H "Authorization: token $(GITHUB_TOKEN)"
else
GITHUB_TOKEN_CURL_ARGUMENT =
endif


###############################################################################
# Core Makefile
###############################################################################

PLATFORM_SRC_FILES = \
	Src/OSD/OSX/FileSystemPath.cpp \
	Src/OSD/OSX/FileDialogs.mm

include Makefiles/Rules.inc

# Universal binary: the CI runs on an arm64 macOS runner, but the release has to run on Intel Macs
# too. Rules.inc initialises ARCH to empty, so this intentional override has to come after the
# include. COMMON_CFLAGS and PLATFORM_LDFLAGS are recursive variables, so they pick this up when
# the compile and link recipes run.
#
# The deployment target must be stated explicitly. Without it clang stamps the runner's SDK version
# into the binary (macOS 26 with the current CI Xcode), and the release then refuses to start on
# anything older. 11.0 is the first Apple Silicon release and a reasonable floor for the Intel
# slice as well; the code needs C++17 and std::filesystem, which macOS 10.15 already provides.
ARCH = -arch arm64 -arch x86_64 -mmacosx-version-min=11.0

# -s (strip) is obsolete and ignored by Apple ld64; remove it to avoid potential warnings
LDOPT := $(filter-out -s,$(LDOPT))

clean:
	$(SILENT)echo Cleaning up \"Frameworks\", \"$(BIN_DIR)\" and \"$(OBJ_DIR)\"...
	$(SILENT)$(DELETE) $(BIN_DIR)
	$(SILENT)$(DELETE) $(OBJ_DIR)
	$(SILENT)$(DELETE) Frameworks/SDL2.* Frameworks/SDL2_net.* Frameworks/libMoltenVK.dylib Frameworks/MoltenVK_icd.json Frameworks/LICENSE-MoltenVK.txt Frameworks/MoltenVK Frameworks/MoltenVK-macos.tar


###############################################################################
# SDL2 Frameworks
#
# SDL2 can be installed in different seemingly incompatible ways on macOS. The
# simplest solution appears to be to download the framework files from the
# official SDL repo.
###############################################################################

Frameworks:
	$(info Creating directory     : $@)
	$(SILENT)mkdir Frameworks

Frameworks/SDL2.dmg.url: | Frameworks
	$(info Finding Latest Release : $@)
	$(SILENT)curl $(GITHUB_TOKEN_CURL_ARGUMENT) --retry 5 --retry-delay 2 --fail-with-body -s https://api.github.com/repos/libsdl-org/SDL/releases | awk '/"browser_download_url": "(.*SDL2-.*\.dmg)"/{m++; if (m>1) exit; print $$2 }' | tr -d '"' > $@

Frameworks/SDL2_net.dmg.url: | Frameworks
	$(info Finding Latest Release : $@)
	$(SILENT)curl $(GITHUB_TOKEN_CURL_ARGUMENT) --retry 5 --retry-delay 2 --fail-with-body -s https://api.github.com/repos/libsdl-org/SDL_net/releases | awk '/"browser_download_url": "(.*SDL2_net-.*\.dmg)"/{m++; if (m>1) exit; print $$2 }' | tr -d '"' > $@

Frameworks/SDL2.dmg: Frameworks/SDL2.dmg.url
	$(info Downloading            : $(shell cat $@.url))
	$(SILENT)curl $(GITHUB_TOKEN_CURL_ARGUMENT) "$(shell cat $@.url)" -sfL --output $@

Frameworks/SDL2_net.dmg: Frameworks/SDL2_net.dmg.url
	$(info Downloading            : $(shell cat $@.url))
	$(SILENT)curl $(GITHUB_TOKEN_CURL_ARGUMENT) "$(shell cat $@.url)" -sfL --output $@

Frameworks/SDL2.framework: Frameworks/SDL2.dmg
	$(info Extracting             : $@)
	$(SILENT)hdiutil attach -quiet Frameworks/SDL2.dmg
	$(SILENT)cp -r /Volumes/SDL2/SDL2.framework Frameworks
	$(SILENT)xattr -dr com.apple.quarantine $@
	$(SILENT)hdiutil detach -quiet /Volumes/SDL2
	$(SILENT)touch $@

Frameworks/SDL2_net.framework: Frameworks/SDL2_net.dmg
	$(info Extracting             : $@)
	$(SILENT)hdiutil attach -quiet Frameworks/SDL2_net.dmg
	$(SILENT)cp -r /Volumes/SDL2_net/SDL2_net.framework Frameworks
	$(SILENT)xattr -dr com.apple.quarantine $@
	$(SILENT)hdiutil detach -quiet /Volumes/SDL2_net
	$(SILENT)touch $@


###############################################################################
# MoltenVK
#
# Bundled so the macOS release needs no Homebrew or Vulkan SDK installation.
# Only the universal dylib, its ICD manifest and the licence are packaged; the
# SDK headers, static library, xcframework and samples are not.
###############################################################################

MOLTENVK_VERSION = 1.3.0
MOLTENVK_URL = https://github.com/KhronosGroup/MoltenVK/releases/download/v$(MOLTENVK_VERSION)/MoltenVK-macos.tar
MOLTENVK_SHA256 = 57b4184ded521b08a63e3642552ebef8b9e98c2f0bcffa49bd93bbe1301c173d

Frameworks/libMoltenVK.dylib: | Frameworks
	$(info Downloading            : MoltenVK $(MOLTENVK_VERSION))
	$(SILENT)curl -fsSL --retry 5 --retry-delay 2 -o Frameworks/MoltenVK-macos.tar $(MOLTENVK_URL)
	$(SILENT)echo "$(MOLTENVK_SHA256)  Frameworks/MoltenVK-macos.tar" | shasum -a 256 -c -
	$(SILENT)tar -xf Frameworks/MoltenVK-macos.tar -C Frameworks
	$(SILENT)cp Frameworks/MoltenVK/MoltenVK/dynamic/dylib/macOS/libMoltenVK.dylib Frameworks/libMoltenVK.dylib
	$(SILENT)cp Frameworks/MoltenVK/MoltenVK/dynamic/dylib/macOS/MoltenVK_icd.json Frameworks/MoltenVK_icd.json
	$(SILENT)cp Frameworks/MoltenVK/LICENSE Frameworks/LICENSE-MoltenVK.txt
	$(SILENT)rm -rf Frameworks/MoltenVK Frameworks/MoltenVK-macos.tar