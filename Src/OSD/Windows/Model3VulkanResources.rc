#include "winuser.h"

// The application icon and the window icon. IDI_MODEL3VULKAN must agree with the #define in
// Src/OSD/SDL/Main.cpp; that is the id SetWindowIcon() loads at run time. Windows uses the
// lowest-numbered ICON resource for the executable icon, so Explorer, the taskbar and Alt-Tab
// all pick this one up.
#define IDI_MODEL3VULKAN 101
IDI_MODEL3VULKAN ICON "output.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Src/OSD/Windows/Model3VulkanManifest.xml"
